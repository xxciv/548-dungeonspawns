+// Scales damage NPCs deal to players (and their pets) inside Solocraft instances.
+class solocraft_system_damage_handler : public UnitScript
+{
+public:
+    solocraft_system_damage_handler() : UnitScript("solocraft_system_damage_handler")
+    {
+        solocraftConfig = SolocraftConfig::getInstance();
+    }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        damage = uint32(damage * GetDamageTakenScale(target, attacker));
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage) override
+    {
+        if (damage > 0)
+            damage = int32(damage * GetDamageTakenScale(target, attacker));
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, int32& damage) override
+    {
+        if (damage > 0)
+            damage = int32(damage * GetDamageTakenScale(target, attacker));
+    }
+
+private:
+    SolocraftConfig solocraftConfig;
+
+    float GetDamageTakenScale(Unit* target, Unit* attacker)
+    {
+        if (solocraftConfig.SoloCraftDamageTakenPct >= 100.0f || !target || !attacker || target == attacker)
+            return 1.0f;
+
+        // Only NPC damage: skip players, and pets, totems or charmed units controlled by players
+        if (attacker->GetTypeId() != TYPEID_UNIT || attacker->IsCharmedOwnedByPlayerOrPlayer())
+            return 1.0f;
+
+        Player* player = target->GetCharmerOrOwnerPlayerOrPlayerItself();
+        if (!player || player->GetMap() != target->GetMap())
+            return 1.0f;
+
+        return GetSolocraftGroupScale(solocraftConfig, player, solocraftConfig.SoloCraftDamageTakenPct);
+    }
+};
+
+// Scales the gold dropped by creatures killed inside Solocraft instances.
+class solocraft_system_money_handler : public PlayerScript
+{
+public:
+    solocraft_system_money_handler() : PlayerScript("solocraft_system_money_handler")
+    {
+        solocraftConfig = SolocraftConfig::getInstance();
+    }
+
+    void OnCreatureLootMoney(Player* looter, Creature* /*creature*/, uint32& gold) override
+    {
+        if (gold)
+            gold = uint32(gold * GetSolocraftGroupScale(solocraftConfig, looter, solocraftConfig.SoloCraftMoneyPct));
+    }
+
+private:
+    SolocraftConfig solocraftConfig;
+};
+
 void AddSC_solocraft_system()
 {
     new solocraft_system_announce();
     new solocraft_system_player_instance_handler();
+    new solocraft_system_damage_handler();
+    new solocraft_system_money_handler();
 }
