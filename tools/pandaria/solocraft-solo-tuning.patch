+// Share (0..1) of the full value for a player in a Solocraft instance: soloPct with 1 player,
+// rising in a straight line to 100% with a full group. 1.0 outside instances or above the level cap.
+static float GetSolocraftGroupScale(SolocraftConfig const& config, Player* player, float soloPct)
+{
+    if (!config.SoloCraftEnable || soloPct >= 100.0f || !player)
+        return 1.0f;
+
+    Map* map = player->GetMap();
+    InstanceMap const* instance = map ? map->ToInstanceMap() : nullptr;
+    if (!instance)
+        return 1.0f;
+
+    auto itr = config.dungeons.find(map->GetId());
+    uint32 dunLevel = itr != config.dungeons.end() ? itr->second : config.SolocraftDungeonLevel;
+    if (player->GetLevel() > dunLevel + config.SolocraftLevelDiff)
+        return 1.0f;
+
+    uint32 maxPlayers = std::max(instance->GetMaxPlayers(), 1u);
+    uint32 players = 1;
+    if (Group* group = player->GetGroup())
+        players = std::max<uint32>(group->GetMembersCount(), 1u);
+    players = std::min(players, maxPlayers);
+
+    float solo = soloPct / 100.0f;
+    if (maxPlayers == 1)
+        return solo;
+
+    return solo + (1.0f - solo) * float(players - 1) / float(maxPlayers - 1);
+}
