 #define SEND_SERVERSIDE_HOLIDAYS
 
+#include <algorithm>
+#include <ctime>
+#include <vector>
+
+// Packed calendar times keep the year in 5 bits counted from 2000. The client reads 31 (2031) as
+// "every year" and anything later overflows, so such dates must never be sent.
+static bool IsPackableCalendarTime(time_t time)
+{
+    tm lt = tm();
+    Trinity::LocalTime(time, lt);
+    return lt.tm_year + 1900 < 2031;
+}
+
+static time_t HolidayDateToTime(uint32 date)
+{
+    tm t = tm();
+    t.tm_year = ((date >> 24) & 0x1F) + 100;
+    t.tm_mon = (date >> 20) & 0xF;
+    t.tm_mday = ((date >> 14) & 0x3F) + 1;
+    t.tm_hour = (date >> 6) & 0x1F;
+    t.tm_min = date & 0x3F;
+    t.tm_isdst = -1;
+    return mktime(&t);
+}
+
 #include "InstanceSaveMgr.h"
 #include "Log.h"
 #include "Opcodes.h"
