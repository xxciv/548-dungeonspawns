+                if (((holiday->Date[i] >> 24) & 0x1F) == 31) // "every year" dates can't be ordered
+                    continue;
+                time_t date = HolidayDateToTime(holiday->Date[i]) + stageOffset;
+                if (date >= event.start)
+                    definedDates.push_back(date);
+            }
+            std::sort(definedDates.begin(), definedDates.end());
+        }
+
