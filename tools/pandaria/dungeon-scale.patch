+
+###############################################################################
+# DUNGEON SCALE
+#   Scales dungeon creatures to the number of players inside the instance,
+#   caps how hard one hit can land, and awards honor for dungeon kills.
+#   Replaces Solocraft's stat buffs: set SoloCraft.Stats.Mult = 0,
+#   SoloCraft.Spellpower.Mult = 0 and SoloCraft.DamageTaken.Pct = 100 so mobs
+#   are not scaled twice (SoloCraft.Money.Pct can stay for the gold penalty).
+#
+# HOW SCALING WORKS
+#   Every multiplier below is the value used when ONE player is inside.
+#   It rises in a straight line to 1.0 at a full group, so a full group
+#   always fights stock mobs.
+#     5-man dungeon, value 0.30:
+#       1 player 0.30 | 2 players 0.475 | 3 players 0.65 | 4 players 0.825 | 5 players 1.00
+#   Health - the creature's max health (its current health % is kept).
+#   Damage - all damage the creature deals: melee, spells and DoTs.
+#   When a player joins or leaves, creatures out of combat are rescaled
+#   within a second; creatures in combat keep their values until the fight
+#   ends for them.
+#
+# RANKS
+#   Normal   - non-elite mobs (and rares).
+#   Elite    - elite and rare-elite mobs (most dungeon trash).
+#   MiniBoss - any boss that is NOT the final boss of the instance.
+#   EndBoss  - the final boss (lastEncounterDungeon in `instance_encounters`).
+#   Adds and triggers summoned by a boss are scaled like that boss.
+#
+# GM COMMANDS (GM level 1+)
+#   .dungeonscale info       - scaling state of the instance you are in
+#   .dungeonscale creature   - rank / multipliers of the selected creature
+#   GMs with GM mode ON do not count as players.
+#
+#   Changes take effect with ".reload config" (creatures out of combat are
+#   rescaled within a second).
+###############################################################################
+
+#    DungeonScale.Enable
+#        Description: Master switch (scaling, hit cap and honor).
+#        Default:     0 - Disabled when the setting is missing
+
+DungeonScale.Enable = 1
+
+#    DungeonScale.Dungeon.Enable / DungeonScale.Raid.Enable / DungeonScale.Scenario.Enable
+#        Description: Which kinds of instances are scaled.
+#                     A per-map DungeonScale.Map.<id>.Enable setting always wins.
+#        Default:     1 - Dungeons (5-man)
+#                     0 - Raids
+#                     0 - Scenarios
+
+DungeonScale.Dungeon.Enable = 1
+DungeonScale.Raid.Enable = 0
+DungeonScale.Scenario.Enable = 0
+
+#    DungeonScale.ChallengeMode.Enable
+#        Description: Scale Challenge Mode dungeons too.
+#        Default:     0 - Challenge Modes are never scaled
+
+DungeonScale.ChallengeMode.Enable = 0
+
+#    DungeonScale.MinPlayers
+#        Description: Scaling never assumes fewer players than this.
+#                     Example: 2 makes a solo player face the "2 players" values.
+#        Default:     1
+
+DungeonScale.MinPlayers = 1
+
+#    DungeonScale.Summons.InheritBossScaling
+#        Description: Creatures summoned by a MiniBoss / EndBoss use the boss's multipliers.
+#        Default:     1 - Enabled
+
+DungeonScale.Summons.InheritBossScaling = 1
+
+#    DungeonScale.IgnoreEntries
+#        Description: Comma separated creature entries that are never scaled
+#                     (e.g. encounter NPCs whose health is set by their script).
+#        Example:     "12345, 67890"
+#        Default:     ""
+
+DungeonScale.IgnoreEntries = ""
+
+#    DungeonScale.<Dungeon|Raid|Scenario>.<Health|Damage>.<Normal|Elite|MiniBoss|EndBoss>
+#        Description: Multiplier with ONE player inside. Valid range 0.01 - 10.0
+#                     (above 1.0 makes small groups face HARDER mobs).
+
+DungeonScale.Dungeon.Health.Normal   = 0.30
+DungeonScale.Dungeon.Health.Elite    = 0.30
+DungeonScale.Dungeon.Health.MiniBoss = 0.35
+DungeonScale.Dungeon.Health.EndBoss  = 0.40
+
+DungeonScale.Dungeon.Damage.Normal   = 0.30
+DungeonScale.Dungeon.Damage.Elite    = 0.30
+DungeonScale.Dungeon.Damage.MiniBoss = 0.35
+DungeonScale.Dungeon.Damage.EndBoss  = 0.35
+
+# Raids (only used when DungeonScale.Raid.Enable = 1; the curve runs to the raid size)
+DungeonScale.Raid.Health.Normal      = 0.08
+DungeonScale.Raid.Health.Elite       = 0.08
+DungeonScale.Raid.Health.MiniBoss    = 0.10
+DungeonScale.Raid.Health.EndBoss     = 0.12
+DungeonScale.Raid.Damage.Normal      = 0.15
+DungeonScale.Raid.Damage.Elite       = 0.15
+DungeonScale.Raid.Damage.MiniBoss    = 0.15
+DungeonScale.Raid.Damage.EndBoss     = 0.15
+
+# Scenarios (3-man; only used when DungeonScale.Scenario.Enable = 1)
+DungeonScale.Scenario.Health.Normal   = 0.45
+DungeonScale.Scenario.Health.Elite    = 0.45
+DungeonScale.Scenario.Health.MiniBoss = 0.50
+DungeonScale.Scenario.Health.EndBoss  = 0.50
+DungeonScale.Scenario.Damage.Normal   = 0.50
+DungeonScale.Scenario.Damage.Elite    = 0.50
+DungeonScale.Scenario.Damage.MiniBoss = 0.50
+DungeonScale.Scenario.Damage.EndBoss  = 0.50
+
+#    DungeonScale.Map.<mapId>.Enable = 0|1          turn scaling + honor off/on for one map
+#    DungeonScale.Map.<mapId>.Health = <value>      every rank's solo health on that map
+#    DungeonScale.Map.<mapId>.Damage = <value>      every rank's solo damage on that map
+#    DungeonScale.Map.<mapId>.Health.<Rank> = <v>   one rank (wins over the line above)
+#    DungeonScale.Map.<mapId>.Damage.<Rank> = <v>
+#        Description: Per-dungeon overrides; anything left out uses the values above.
+#                     ".dungeonscale info" (or ".gps") shows the map id.
+#                     36 Deadmines, 959 Shado-Pan Monastery, 960 Temple of the Jade Serpent,
+#                     961 Stormstout Brewery, 962 Gate of the Setting Sun, 994 Mogu'shan Palace,
+#                     1001 Scarlet Halls, 1004 Scarlet Monastery, 1007 Scholomance,
+#                     1011 Siege of Niuzao Temple
+#        Example:     DungeonScale.Map.961.Damage = 0.25
+
+#    DungeonScale.RankOverride
+#        Description: Force the rank of creature entries, for scaling AND honor.
+#                     Format: "entry:Rank, entry:Rank" (Normal | Elite | MiniBoss | EndBoss)
+#        Example:     "56448:EndBoss, 59051:MiniBoss"
+#        Default:     ""
+
+DungeonScale.RankOverride = ""
+
+#    DungeonScale.HitCap.Pct
+#        Description: No single hit (or DoT tick) from a scaled creature takes more
+#                     than this percent of the victim's max health. Applies to
+#                     players and their pets while the group is not full.
+#                     The combat log still shows the uncapped number.
+#        Default:     35 - 0 disables the cap
+
+DungeonScale.HitCap.Pct = 35
+
+#    DungeonScale.Honor.Enable
+#        Description: Award honor for kills in scaled instances. Every group member
+#                     inside and in reward range gets the full amount (not split).
+#                     Honor caps still apply.
+#        Default:     1 - Enabled
+
+DungeonScale.Honor.Enable = 1
+
+#    DungeonScale.Honor.<Rank>
+#        Description: Honor per kill for each rank. 0 disables that rank.
+
+DungeonScale.Honor.Normal   = 1
+DungeonScale.Honor.Elite    = 5
+DungeonScale.Honor.MiniBoss = 10
+DungeonScale.Honor.EndBoss  = 25
+
+#    DungeonScale.Honor.IgnoreSummons
+#        Description: No honor for summoned creatures (boss adds, spawned waves).
+#        Default:     1
+
+DungeonScale.Honor.IgnoreSummons = 1
+
+#    DungeonScale.Honor.IgnoreGrayMobs
+#        Description: No honor for mobs that are gray to the player.
+#        Default:     0 - Gray mobs still give honor
+
+DungeonScale.Honor.IgnoreGrayMobs = 0
